# Copy this file to .env and fill in values only when a lesson needs them.
# .env is in .gitignore, so it is never committed.

# HubSpot service key (Development -> Keys -> Service keys). Used by 07-crm-hubspot/hubspot_client.py
HUBSPOT_TOKEN=

# Anthropic API key (console.anthropic.com). Used by 09-claude-and-ai/claude_scoring.py --live
ANTHROPIC_API_KEY=

# Slack incoming webhook URL. Used by 10-production-habits/examples/slack_alert.py
SLACK_WEBHOOK_URL=

# Optional: the practice API's random failure rate (0 to 1). Default 0.05
PRACTICE_FAIL_RATE=0.05
